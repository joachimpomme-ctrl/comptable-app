# =============================================================================
# Agent IA Comptable & Patrimoine — variables d'environnement
# Copier en .env.local et remplir. Ne JAMAIS committer .env.local.
# =============================================================================

# ---- Anthropic (Claude) ----------------------------------------------------
# Clé unique côté serveur (jamais exposée au client). Plan API avec prompt
# caching activé. Récupérer sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Modèles utilisés. Le toggle UI bascule entre les deux.
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
ANTHROPIC_MODEL_OPUS=claude-opus-4-7

# ---- Auth.js (NextAuth v5) -------------------------------------------------
# Generate via: openssl rand -base64 32
AUTH_SECRET=

# URL canonique (en dev: http://localhost:3000)
AUTH_URL=http://localhost:3000

# ---- Google OAuth ----------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# Type: Web application
# Redirect URI autorisée: ${AUTH_URL}/api/auth/callback/google
# Scopes activés côté projet:
#   - openid email profile
#   - https://www.googleapis.com/auth/drive.file
#   - https://www.googleapis.com/auth/spreadsheets
#   - https://www.googleapis.com/auth/documents
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# (Optionnel) Alias historiques utilisés par certaines libs Google
GOOGLE_CLIENT_ID=${AUTH_GOOGLE_ID}
GOOGLE_CLIENT_SECRET=${AUTH_GOOGLE_SECRET}

# ---- Allowlist serveur -----------------------------------------------------
# Emails autorisés à se connecter, séparés par virgules. Vérifié dans le
# callback signIn d'Auth.js. Toute connexion hors liste est rejetée.
ALLOWED_EMAILS=joachim@example.com,alice@example.com

# ---- Supabase / Postgres ---------------------------------------------------
# Connection string Postgres directe (region EU recommandée).
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Pour Drizzle on utilise la connexion directe (pas le pooler PgBouncer
# pour les migrations). En runtime serverless on peut basculer sur le
# pooler "transaction" via DATABASE_URL_POOLED.
DATABASE_URL=postgres://postgres:password@db.xxxxx.supabase.co:5432/postgres?sslmode=require
# DATABASE_URL_POOLED=postgres://postgres.xxxxx:password@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?sslmode=require

# ---- Knowledge build -------------------------------------------------------
# Repo source du corpus métier (public). Le script clone en /.cache/comptable.
COMPTABLE_REPO_URL=https://github.com/joachimpomme-ctrl/comptable.git
COMPTABLE_REPO_REF=main
