# ============================================================
# Compta Multi-Agents — Environment Variables
# Copy to .env.local and fill in real values.
# ============================================================

# --- Gemini API ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Models (override defaults if needed) ---
# Cf. https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro

# --- Google Sheets persistence ---
# ID of the Sheets file used as Historique_Compta
# (URL: https://docs.google.com/spreadsheets/d/<ID>/edit)
SHEETS_ID=

# Service account JSON, base64-encoded.
# Generate with:  cat service-account.json | base64
SHEETS_SERVICE_ACCOUNT_B64=
