# ============================================================
# Compta Multi-Agents — Environment Variables
# Copy to .env.local and fill in real values.
# ============================================================

# --- Gemini API (required) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Anthropic Claude API (optional — enables hybrid multi-provider pipeline) ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Gemini models ---
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro

# --- Claude models (used when an agent's *_PROVIDER is set to "anthropic") ---
CLAUDE_MODEL_HAIKU=claude-haiku-4-5-20251001
CLAUDE_MODEL_SONNET=claude-sonnet-4-6
CLAUDE_MODEL_OPUS=claude-opus-4-7

# --- Per-agent provider/model overrides (default values shown) ---
# Reviewer is the highest-value Claude switch (cognitive diversity vs Gemini Gem).
AGENT_ORCH_PROVIDER=gemini
AGENT_ORCH_MODEL=
AGENT_REVIEWER_PROVIDER=anthropic
AGENT_REVIEWER_MODEL=claude-sonnet-4-6
AGENT_REVIEWER_IRREVERSIBLE_MODEL=claude-opus-4-7
AGENT_PARAM_PROVIDER=gemini
AGENT_PARAM_MODEL=

# --- Google Sheets persistence ---
# ID of the Sheets file used as Historique_Compta
# (URL: https://docs.google.com/spreadsheets/d/<ID>/edit)
SHEETS_ID=

# Service account JSON, base64-encoded.
# Generate with:  cat service-account.json | base64
SHEETS_SERVICE_ACCOUNT_B64=
